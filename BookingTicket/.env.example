# Copy to .env and adjust (all services load this file from repo root).
# Paths: each *-service runs with cwd = its folder; dotenv loads ../.env

NODE_ENV=development

# Redis (pub/sub + wallet event store)
REDIS_HOST=localhost
REDIS_PORT=6379

# Service ports
USER_SERVICE_PORT=8081
MOVIE_SERVICE_PORT=8082
BOOKING_SERVICE_PORT=8083
PAYMENT_NOTIFICATION_SERVICE_PORT=8084
WALLET_SERVICE_PORT=8085

# HTTP URLs used by booking-service (set to host:port where those services listen)
MOVIE_SERVICE_URL=http://localhost:8082
WALLET_SERVICE_URL=http://localhost:8085

# user-service
JWT_SECRET=movie_ticket_secret_2024

# wallet-service: initial balance when USER_REGISTERED (VND)
WALLET_INITIAL_BALANCE=5000000
